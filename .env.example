# Groq powers the optional AI review pass. Without a key, scans are static-only.
# Provide one key, or several for automatic rotation on rate limits.
GROQ_API_KEY=gsk_your_api_key_here
# GROQ_API_KEYS=key1,key2,key3
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# Optional: lets Datum scan private repos and avoids GitHub's anonymous rate limit.
# A fine-grained token with read-only "Contents" access is enough.
GITHUB_TOKEN=
